# The AI tutor chat (/api/tutor) runs against a locally installed Ollama.
# Install Ollama (https://ollama.com), then pull the model:
#   ollama pull qwen2.5-coder:7b
# No API key needed.

# Optional: override where Ollama is running.
# Defaults to http://localhost:11434
# OLLAMA_HOST=http://localhost:11434

# Optional: override the model used by the tutor.
# Defaults to qwen2.5-coder:7b
# OLLAMA_MODEL=qwen2.5-coder:7b
